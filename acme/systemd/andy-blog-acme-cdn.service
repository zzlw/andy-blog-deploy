[Unit]
Description=andy-blog CDN 证书续期（acme.sh DNS-01，只推 static.jiawen.live）
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/andy-blog
ExecStart=/usr/bin/docker compose -f docker-compose.acme.yml --env-file .env.production --env-file .env.production.local run --rm acme acme.sh --cron
Nice=10
